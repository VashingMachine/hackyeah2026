# Copy to blackwall/.env (git-ignored) and fill in with your own credentials.
# Do not put production credentials in demo prompts, shell commands, recordings, or reports.
OPENAI_API_KEY=                 # required: gpt-6-luna executor/guardian and text-embedding-3-small
JEV_API_KEY=                    # required: Jev semantic judge
BLACKWALL_ADMIN_TOKEN=          # optional locally; always set a private value before exposing the server
BLACKWALL_OPENAI_RESPONSES_URL=  # optional endpoint override; default is https://api.openai.com/v1/responses
JEV_BASE_URL=                   # optional TypeSafe endpoint override
BLACKWALL_GUARDIAN_TIMEOUT_MS=  # optional; defaults to 30000

{
  "name": "blackwall",
  "version": "0.1.0",
  "description": "Blackwall — AI control layer (HackYeah 2026)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server/main.ts",
    "test": "vitest run --exclude 'test/live/**' --exclude 'test/e2e/**'",
    "test:live": "vitest run test/live",
    "test:e2e": "vitest run test/e2e",
    "eval": "node scripts/eval.ts",
    "typecheck": "tsc -p tsconfig.json"
  },

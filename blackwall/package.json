  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.1",
    "@huggingface/transformers": "^4.3.0",
    "fastify": "^5.12.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

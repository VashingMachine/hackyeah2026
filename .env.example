# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=      # executor model and session guardian (required)
JEV_API_KEY=            # Jev (TypeSafe) semantic judge (required)
OPENAI_API_KEY=         # optional: only if topic_supervision.embedding.provider is `openai`
BLACKWALL_ADMIN_TOKEN=  # protects /v1/admin/* and the dashboard API; set a real value outside local demos
